node_modules/
lib/
.artifacts/
.env
coverage/
# The canonical lockfile is pnpm-lock.yaml (`packageManager: pnpm@11.7.0`). npm is only used on Windows because pnpm 11
# fails there on unapproved build scripts, so an npm lockfile is a local artifact and must not become a second source of
# truth for dependency resolution.
package-lock.json
# Written by the wxauto library into whatever directory a process starts in, so a run of the live suite leaves one behind.
wxauto_logs/
# The sidecar writes these next to itself at run time. They hold chat content and message text,
# so they stay out of history.
bridge.log
sidecar*.log
poc/probe-report.json
__pycache__/
*.pyc
# Never commit a bearer token.
secrets/
